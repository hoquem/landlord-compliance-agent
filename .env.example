# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Values below marked "local dev default" apply only when running the Supabase
# local stack (`supabase start`); switch to your remote project's values for
# staging/production.

# Local Supabase Postgres. Port from supabase/config.toml [db].port; verify
# user/password against `supabase start` output (CLI's local-dev convention).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Base URL of the Supabase API. Port confirmed from supabase/config.toml [api].port (54321).
SUPABASE_URL=http://127.0.0.1:54321

# Public/browser-safe API key. Paste the value `supabase start` prints (local-only demo key).
SUPABASE_ANON_KEY=

# Server-side key with elevated privileges — never expose to a client.
# Paste the value `supabase start` prints (local-only demo key).
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to verify Supabase-issued JWTs.
# Paste the value `supabase start` prints (local-only demo secret).
SUPABASE_JWT_SECRET=

# Anthropic API key for the compliance agent's LLM calls (sk-ant-...).
# Get one from https://console.anthropic.com/ — real secret, never commit.
ANTHROPIC_API_KEY=
