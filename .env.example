# Copy to .env and fill in real values. .env is gitignored — never commit it.
# DATABASE_URL and SUPABASE_URL are pre-filled with local-stack defaults
# (`supabase start`); switch to your remote project's values for
# staging/production.

# Local Supabase Postgres. Confirmed against live `supabase start` output (DB_URL).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Base URL of the Supabase API. Confirmed against live `supabase start` output (API_URL).
SUPABASE_URL=http://127.0.0.1:54321

# Public/browser-safe API key. Paste the value `supabase start` prints (local-only demo key).
SUPABASE_ANON_KEY=

# Server-side key with elevated privileges — never expose to a client.
# Paste the value `supabase start` prints (local-only demo key).
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to verify Supabase-issued JWTs.
# Paste the value `supabase start` prints (local-only demo secret).
SUPABASE_JWT_SECRET=

# Anthropic API key — only required if CATEGORISER_MODEL below is set to a
# hosted Anthropic model (e.g. "anthropic/claude-sonnet-4-...."). Not needed
# for a local Ollama model. Get one from https://console.anthropic.com/ —
# real secret, never commit.
ANTHROPIC_API_KEY=

# LiteLLM/CrewAI model id for the categorisation flow's agent. Required —
# the flow fails loudly at startup if this is unset, and never falls back
# to a default provider (bank statement data should not go to a provider
# you didn't explicitly choose). Verify the tag exists on your Ollama
# install first (`ollama list`). Example for a local Ollama model:
CATEGORISER_MODEL=ollama/glm-4.5-air

# Bank-data privacy: disable CrewAI telemetry/event export so statement
# content can never leave the machine via instrumentation, even with a
# local model. Keep these set in every environment that runs the flow.
CREWAI_TELEMETRY_OPT_OUT=true
OTEL_SDK_DISABLED=true
# Example for a hosted model instead:
# CATEGORISER_MODEL=anthropic/claude-sonnet-4-20250514

# Google Cloud OAuth 2.0 client credentials, type "Web application".
# Google is the only sign-in method the app offers (no email/password UI).
# Read by supabase/config.toml's [auth.external.google] through env()
# substitution, so the secret never enters the tracked config file.
#
# Create at https://console.cloud.google.com/apis/credentials. The client's
# Authorised redirect URIs must contain the SUPABASE callback, not the app URL:
#   local:  http://127.0.0.1:54321/auth/v1/callback
#   cloud:  https://<project-ref>.supabase.co/auth/v1/callback
# Put both on one client so local and cloud share it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Base URL of a local Ollama server, only used when CATEGORISER_MODEL is an
# "ollama/..." id. Optional — defaults to Ollama's own default
# (http://localhost:11434) when unset.
OLLAMA_BASE_URL=http://localhost:11434
