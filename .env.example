# Copy to .env and fill in real values. .env is gitignored — never commit it.
# DATABASE_URL and SUPABASE_URL are pre-filled with local-stack defaults
# (`supabase start`); switch to your remote project's values for
# staging/production.

# Local Supabase Postgres. Confirmed against live `supabase start` output (DB_URL).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Least-privilege database roles, created by
# supabase/migrations/0006_least_privilege_roles.sql.
#
# API_DATABASE_URL must NOT be the superuser: app_api has row-level
# security enforced, so a forgotten org_id filter returns nothing instead
# of another customer's rows. Pointing this at postgres silently undoes
# the entire tenant boundary and every test would still pass.
#
# WORKER_DATABASE_URL is BYPASSRLS on purpose: the worker claims jobs
# across orgs and has no authenticated caller to scope it. Its boundary
# is the org_id on the claimed row -- see backend/src/worker/jobs.py.
#
# The passwords below are local-development values. CHANGE THEM in any
# real deployment: `alter role app_api password '...'`.
API_DATABASE_URL=postgresql://app_api:app_api_local_dev@127.0.0.1:54322/postgres
WORKER_DATABASE_URL=postgresql://app_worker:app_worker_local_dev@127.0.0.1:54322/postgres

# Base URL of the Supabase API. Confirmed against live `supabase start` output (API_URL).
SUPABASE_URL=http://127.0.0.1:54321

# Public/browser-safe API key. Paste the value `supabase start` prints (local-only demo key).
SUPABASE_ANON_KEY=

# Server-side key with elevated privileges — never expose to a client.
# Paste the value `supabase start` prints (local-only demo key).
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to verify Supabase-issued JWTs.
# Paste the value `supabase start` prints (local-only demo secret).
SUPABASE_JWT_SECRET=

# Anthropic API key — only required if CATEGORISER_MODEL below is set to a
# hosted Anthropic model (e.g. "anthropic/claude-sonnet-4-...."). Not needed
# for a local Ollama model. Get one from https://console.anthropic.com/ —
# real secret, never commit.
ANTHROPIC_API_KEY=

# LiteLLM/CrewAI model id for the categorisation flow's agent. Required —
# the flow fails loudly at startup if this is unset, and never falls back
# to a default provider (bank statement data should not go to a provider
# you didn't explicitly choose). Verify the tag exists on your Ollama
# install first (`ollama list`).
#
# "ollama/" DOES NOT MEAN LOCAL. A ":cloud" tag is Ollama's hosted
# inference — `ollama list` shows it as a ~320-byte pointer manifest rather
# than gigabytes of weights, and statement descriptions go over the network
# to Ollama. Only a pulled model with real weights keeps bank data on the
# machine. Check the SIZE column before assuming.
#
# Two further things worth knowing before trusting a model here, both
# measured 2026-08-04. Ollama retires cloud models, and without warning --
# three of the five installed on this machine answer 410. And nothing on the
# :cloud path constrains decoding: both OpenAI-compatible
# `response_format={"type":"json_schema","strict":true}` and Ollama's own
# `format=<schema>` were dropped in transit, so output format rests entirely
# on the model following the prompt. The flow parses the reply itself and
# tolerates a markdown fence for exactly this reason (see
# src/flows/categorise.py), but a model that answers in prose will still
# fail -- loudly, quoting itself.
#
# `evals/run_eval.py --limit 1 --model <id>` is the cheapest way to find out
# what you have; the full run gives an accuracy number to choose on.
#
# Example for a local Ollama model:
CATEGORISER_MODEL=ollama/glm-4.5-air

# Comma-separated list of exact origins the Flutter web app is served from.
# REQUIRED: src/api/main.py raises at import without it, and refuses '*'.
# Without CORS the browser blocks every response before the app sees it,
# which surfaces as "ClientException: Failed to fetch" with no status code
# and no server-side error at all. Local development wants both spellings
# of localhost; production wants the deployed origin and nothing else.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Bank-data privacy: disable CrewAI telemetry/event export so statement
# content can never leave the machine via instrumentation, even with a
# local model. Keep these set in every environment that runs the flow.
#
# OTEL_SDK_DISABLED is the one that works. Measured against the installed
# crewai 1.15.8 (Task 18): `Telemetry._is_telemetry_disabled` reads exactly
# OTEL_SDK_DISABLED, CREWAI_DISABLE_TELEMETRY and CREWAI_DISABLE_TRACKING.
# CREWAI_TELEMETRY_OPT_OUT is the 0.x spelling and is read by NO installed
# package -- verified by grepping the whole of site-packages. It is kept
# only so that a downgrade or a sibling tool expecting the old name still
# finds it; it is not what is protecting anything today.
#
# `src/worker/main.py` refuses to start unless OTEL_SDK_DISABLED is true,
# and checks it *before* importing CrewAI -- crewai/llm.py calls
# load_dotenv() at module scope, so a later check would pass because CrewAI
# had just set the variable itself.
CREWAI_TELEMETRY_OPT_OUT=true
OTEL_SDK_DISABLED=true
# Example for a hosted model instead:
# CATEGORISER_MODEL=anthropic/claude-sonnet-4-20250514

# Google Cloud OAuth 2.0 client credentials, type "Web application".
# Google is the only sign-in method the app offers (no email/password UI).
# Read by supabase/config.toml's [auth.external.google] through env()
# substitution, so the secret never enters the tracked config file.
#
# Create at https://console.cloud.google.com/apis/credentials. The client's
# Authorised redirect URIs must contain the SUPABASE callback, not the app URL:
#   local:  http://127.0.0.1:54321/auth/v1/callback
#   cloud:  https://<project-ref>.supabase.co/auth/v1/callback
# Put both on one client so local and cloud share it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Base URL of a local Ollama server, only used when CATEGORISER_MODEL is an
# "ollama/..." id. Optional — defaults to Ollama's own default
# (http://localhost:11434) when unset.
OLLAMA_BASE_URL=http://localhost:11434

# macOS only. WeasyPrint (the export PDF renderer) loads libgobject/pango/
# cairo through dlopen, and Homebrew installs them outside dyld's default
# search path -- so `import weasyprint` raises OSError without this. Linux
# and Docker images need nothing here; leave it unset there.
#   brew install pango
DYLD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib
